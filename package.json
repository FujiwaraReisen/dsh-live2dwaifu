{
  "name": "dsh-live2dwaifu",
  "version": "1.0.3",
  "description": "给 DSH 网页右下角请一个 Live2D 角色：会眨眼、会呼吸、视线跟着鼠标、点她有反应、说话时嘴动、心情变了眉毛跟着动。模型不用内置——谁装谁放自己的文件夹；支持自定义 .exp3.json 表情和 .motion3.json 动作，卡片能拖能缩，背景可换。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "live2d",
    "cubism",
    "widget"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FujiwaraReisen/dsh-live2dwaifu.git"
  },
  "homepage": "https://github.com/FujiwaraReisen/dsh-live2dwaifu#readme",
  "bugs": {
    "url": "https://github.com/FujiwaraReisen/dsh-live2dwaifu/issues"
  }
}